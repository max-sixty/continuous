{# The action ref pins to the generator's own release tag. Every harness ships
   from this repo under a harness-named path (claude/, codex/); release tags
   are immutable per docs/security-model.md, so the pin is a stable supply-chain
   anchor. Consumers move forward via the nightly `uvx tend@latest init` regen
   pulling a newer generator, which restamps a newer tag as a reviewable diff
   in their own repo. `version("tend")` only resolves to an existing tag when
   generation runs from a released package — generating from in-tree source
   pins a tag that does not exist yet; never commit those workflows (see
   CLAUDE.md).

   Claude emits both `claude_code_oauth_token` and `anthropic_api_key`
   unconditionally; the action validates at least one is set and routes the
   active credential through its credential proxy (OAuth wins when both are
   present), treating empty as absent. Codex takes a single `openai_api_key` —
   the subscription `auth.json` path is incompatible with tend's concurrent
   workflows and is not exposed. #}
{% macro agent_step(cfg, prompt_body, if_condition='') %}
{% if cfg.harness == 'claude' %}
      - uses: max-sixty/tend/claude@<<tend_version>>
{% else %}
      - uses: max-sixty/tend/codex@<<tend_version>>
{% endif %}
{% if if_condition %}
        if: <<if_condition>>
{% endif %}
        with:
          github_token: ${{ secrets.<<bot_token_secret>> }}
{% if cfg.harness == 'claude' %}
          claude_code_oauth_token: ${{ secrets.<<claude_token_secret>> }}
          anthropic_api_key: ${{ secrets.<<anthropic_api_key_secret>> }}
{% else %}
          openai_api_key: ${{ secrets.<<openai_key_secret>> }}
{% if cfg.effort %}
          effort: <<cfg.effort>>
{% endif %}
{% endif %}
          bot_name: <<cfg.bot_name>>
          model: <<cfg.model>>
{% if cfg.harness == 'claude' %}
{% if cfg.sandbox_path %}
          sandbox_path: |
{% for dir in cfg.sandbox_path %}
            <<dir>>
{% endfor %}
{% endif %}
{% if cfg.sandbox_env %}
          sandbox_env: |
{% for name, value in cfg.sandbox_env.items() %}
            <<name>>=<<value>>
{% endfor %}
{% endif %}
{% if cfg.sandbox_setup %}
          sandbox_setup: |
{% for cmd in cfg.sandbox_setup %}
            <<cmd|indent(12)>>
{% endfor %}
{% endif %}
{% endif %}
          <<prompt_body>>
{%- endmacro %}

{# Environment block at column 4. The environment is a secret scope, not a
   deploy target: its branch policy is what stops a workflow pushed to a
   feature branch reading the operational secrets (see TEND_ENVIRONMENT in
   workflows.py). GitHub does not separate the two, so a job naming one also
   gets a deployment record, filed against whatever the run belongs to — under
   `pull_request_target` that is the PR's own head, so every push to every PR
   grew a "<bot> deployed to tend" line in its timeline.

   `deployment: false` drops the record and keeps the gate. Checked against
   live GitHub rather than assumed, because dropping the record could as
   easily have dropped the check that files it: with the property set, a job
   on an admitted ref still receives the environment's secrets, and one on an
   excluded ref is still refused before its first step with `Branch "x" is not
   allowed to deploy to <env> due to environment protection rules`. #}
{% macro environment() %}
    environment:
      name: <<tend_environment>>
      deployment: false
{%- endmacro %}

{# Permissions block at column 6. `issues` defaults to True because every
   workflow except ci-fix needs it. The trailing inline conditional avoids
   the trim_blocks-eats-the-separator issue between `actions: read` and
   `      issues: write` that arises with `{% if %}` on its own line.

   No `id-token: write`: nothing in the harness actions requests an OIDC
   token, and a job holding it can mint the repository's OIDC identity for
   any relying party whose trust policy doesn't pin the workflow and ref.
   An adopter whose `setup:` authenticates over OIDC re-adds it with a
   `jobs.<name>.permissions` override. #}
{% macro permissions(issues=True) %}
      contents: write
      pull-requests: write
      actions: read<<'\n      issues: write' if issues else ''>>
{%- endmacro %}

{# Skip a job when running outside the canonical owner. Compares
   `github.repository_owner` against the configured owner: `secrets` isn't
   available in `jobs.<job_id>.if`, and `github.event.repository.fork` is null
   for `schedule` events, so the owner string is the only check that works
   across all the affected event types.

   Two shapes:
   - fork_guard_if(cfg): emits `    if: <expr>` on its own line, or nothing
   - fork_guard_prefix(cfg): emits `<expr> && ` inline, or nothing — used
     when the job already has an `if:` (e.g. ci-fix's conclusion check) #}
{% macro fork_guard_if(cfg) %}
{% if cfg.repo_owner %}
    if: github.repository_owner == '<<cfg.repo_owner|replace("'", "''")>>'
{% endif %}
{%- endmacro %}

{# True when the issue carries none of the labels tend puts on its own
   bookkeeping issues. The list lives in workflows.py so a new one reaches
   every workflow at once; see BOOKKEEPING_LABELS for why they are skipped.

   `contains(…) == false` rather than `!contains(…)`: a value starting with
   `!` is a tag indicator to YAML, so the negated form only parses where the
   expression is already inside a block scalar. This one renders in both. #}
{% macro not_bookkeeping() -%}
{% for label in bookkeeping_labels %}contains(github.event.issue.labels.*.name, '<<label>>') == false{% if not loop.last %} && {% endif %}{% endfor %}
{%- endmacro %}

{% macro fork_guard_prefix(cfg) -%}
{% if cfg.repo_owner %}github.repository_owner == '<<cfg.repo_owner|replace("'", "''")>>' && {% endif %}
{%- endmacro %}

{# Shared `actions/checkout@v7` step. Omitting `ref` takes the event's own ref,
   which under `pull_request_target` is the PR's base branch — what mention and
   review's first checkout both want. Callers needing a specific tree pass one:
   the configured default branch, or review's pr_ref dispatch. `if_condition`
   gates the step (used by notifications' skip_condition).

   `allow_unsafe_pr_checkout` opts into checkout's fork-PR guard: v7 refuses to
   check out a fork's `refs/pull/N/{merge,head}` under `pull_request_target`
   (the "pwn request" guard) unless this input is set. Only review feeds a fork
   ref straight to the action, so only it sets this; mention checks out the base
   repo then `gh pr checkout`s, never handing the action a fork ref.

   `clean=False` drops checkout's `git clean -ffdx && git reset --hard`, which
   would otherwise delete what an earlier step wrote into the workspace. Review
   sets it on its second checkout, where `setup:` has already run. #}
{% macro checkout(cfg, ref=None, if_condition='', allow_unsafe_pr_checkout=False, clean=True) %}
      - uses: actions/checkout@v7
{% if if_condition %}
        if: <<if_condition>>
{% endif %}
        with:
{% if ref %}
          ref: <<ref>>
{% endif %}
{% if allow_unsafe_pr_checkout %}
          allow-unsafe-pr-checkout: true
{% endif %}
{% if not clean %}
          clean: false
{% endif %}
          fetch-depth: 0
          fetch-tags: true
          token: ${{ secrets.<<bot_token_secret>> }}
{%- endmacro %}

{# Put the local composites named by `setup:` back the way the job loaded them,
   for the workflows that swap the workspace tree afterwards (review, mention).

   A `uses: ./path` is read from the workspace, and the runner reads it a second
   time at job end to dispatch the POST steps of the actions nested inside it —
   `Swatinem/rust-cache` and friends — indexing into the step list it cached the
   first time. By then the PR's own tree is on disk, so a PR that edits the
   composite's step count fails cleanup with `Index was out of range`, and one
   that drops the file entirely with `Can't find 'action.yml'`. Both paint the
   job red after a session that did its work correctly. actions/runner#2816.

   `$GITHUB_SHA` names the tree the job's first checkout took: both callers give
   that checkout no `ref`, and `actions/checkout` then resolves the triggering
   event's own commit. So it is by construction the tree the composite loaded
   from, whatever branch the event put there. Every main step runs ahead of
   every POST step, so any position below the tree switch is early enough.
   `paths` is empty for a `setup:` that names no local action, rendering this
   away. #}
{% macro restore_local_actions(run_body) %}
{% if run_body %}


      - name: Restore local setup actions for POST cleanup
        if: always()
        run: |
<<run_body|indent(10, first=True)>>
{%- endif %}
{%- endmacro %}

{# YAML block scalar prompt at column 10, with the supplied text indented at
   column 12. Used by workflows whose prompt is just the bare invocation
   (triage, scheduled, notifications); review and ci-fix have richer prompt
   shapes that they inline. #}
{% macro block_prompt(prompt) -%}
prompt: |
<<prompt|indent(12, first=True, blank=True)>>
{%- endmacro %}
