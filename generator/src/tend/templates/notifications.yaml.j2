<<header>>
name: tend-notifications
on:
  schedule:
    - cron: "<<cron>>"
  workflow_dispatch:

jobs:
  notifications:
    concurrency:
      group: tend-notifications
      cancel-in-progress: false
<<fork_guard_if(cfg)>>    runs-on: ubuntu-24.04
<<environment()>>
    permissions:
<<permissions()>>
    steps:
<<check_tend_enabled(cfg)>>
      - name: Check for unread notifications and conflicted PRs
        id: check
        if: <<tend_enabled_condition>>
        env:
          GITHUB_TOKEN: ${{ secrets.<<bot_token_secret>> }}
        run: |
<<check_script|indent(10, first=True)>>

<<checkout(cfg, ref=cfg.default_branch, if_condition="(" ~ tend_enabled_condition ~ ") && (" ~ skip_condition ~ ")")>>
<<setup>><<agent_step(cfg, block_input('prompt', prompt), if_condition="(" ~ tend_enabled_condition ~ ") && (" ~ skip_condition ~ ")")>>
