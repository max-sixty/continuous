{# The review events carry `refs/pull/N/merge`, which the operational secrets'
   environment does not admit — and cannot, because a same-repo `pull_request`
   run shares that ref and runs the PR head's own workflow file, so admitting it
   would hand a hijacked session the secrets it is meant to be denied.

   So the review events land here instead, in a workflow holding no secrets, and
   reach tend-mention as a `repository_dispatch`, which carries the default
   branch. GitHub creates that run even though a `GITHUB_TOKEN` triggered it:
   `workflow_dispatch` and `repository_dispatch` are the two events exempt from
   the rule that token-triggered events start no workflow.

   Everything that decides *whether* the bot should wake lives here rather than
   in tend-mention, because this is where the review payload is. The dispatch
   fires only when the answer is yes, so a skipped review costs a runner with no
   credentials on it and never reaches the environment at all. #}
<<header>>
name: tend-mention-relay
on:
  pull_request_review:
    types: [submitted]
  # `created` is intentionally absent, matching tend-mention: GitHub fires both
  # pull_request_review and pull_request_review_comment for every newly-created
  # inline comment, so subscribing to it would relay each one twice. Edits have
  # no sibling event, so `edited` is still needed to catch edit-to-summon.
  pull_request_review_comment:
    types: [edited]

# No secrets, and `contents: read` is all the dispatch POST needs — verified
# against the API rather than assumed.
permissions:
  contents: read

jobs:
  relay:
    # Fork PRs are excluded to hold today's behaviour: the notifications poll
    # covers them, and routing them here would newly wake a secret-bearing run
    # on a review body written by anyone, bypassing the author-association
    # tiers that path applies. Widening this is a separate decision.
    if: |
      github.event.pull_request.head.repo.full_name == github.repository
    runs-on: ubuntu-24.04
    steps:
      - name: Decide whether the bot should respond
        id: check
        run: |
          # An approval the bot left on its own PR with an empty body is
          # terminal — the engagement heuristics below would otherwise count
          # this very review and wake a session with nothing to act on. A
          # bot review that requests changes, or carries a body, keeps
          # actionable signal and falls through. `review.state` arrives
          # lowercase in the webhook payload.
          if [ "$EVENT_NAME" = "pull_request_review" ] \
             && [ "$REVIEW_AUTHOR" = "<<cfg.bot_name>>" ] \
             && [ "$REVIEW_STATE" = "approved" ] \
             && [ -z "$REVIEW_BODY" ]; then
            echo "dispatch=false" >> "$GITHUB_OUTPUT"; exit 0
          fi

          # The bot's own inline comments never summon it; a bot comment
          # quoting an earlier @-mention would otherwise re-match below.
          if [ "$EVENT_NAME" = "pull_request_review_comment" ] \
             && [ "$COMMENT_AUTHOR" = "<<cfg.bot_name>>" ]; then
            echo "dispatch=false" >> "$GITHUB_OUTPUT"; exit 0
          fi

          if [ -n "$BODY" ] && printf '%s\n' "$BODY" | grep -qF '@<<cfg.bot_name>>'; then
            echo "dispatch=true" >> "$GITHUB_OUTPUT"
            echo "reason=mention" >> "$GITHUB_OUTPUT"; exit 0
          fi

          # A pull_request_review payload carries review.body but not the
          # bodies of the inline comments attached to it, so a first-contact
          # @-mention inside one is invisible above. Fetch them.
          if [ "$EVENT_NAME" = "pull_request_review" ] && [ -n "$REVIEW_ID" ]; then
            if gh api --paginate "repos/$GITHUB_REPOSITORY/pulls/$PR_NUMBER/reviews/$REVIEW_ID/comments" \
                 --jq '.[].body' | grep -qF '@<<cfg.bot_name>>'; then
              echo "dispatch=true" >> "$GITHUB_OUTPUT"
              echo "reason=mention" >> "$GITHUB_OUTPUT"; exit 0
            fi
          fi

          # No mention: relay only where the bot already participates.
          PR_AUTHOR=$(gh pr view "$PR_NUMBER" --repo "$GITHUB_REPOSITORY" --json author --jq '.author.login')
          if [ "$PR_AUTHOR" = "<<cfg.bot_name>>" ]; then
            echo "dispatch=true" >> "$GITHUB_OUTPUT"
            echo "reason=participation" >> "$GITHUB_OUTPUT"; exit 0
          fi

          BOT_REVIEWS=$(gh api --paginate "repos/$GITHUB_REPOSITORY/pulls/$PR_NUMBER/reviews" \
            --jq '[.[] | select(.user.login == "<<cfg.bot_name>>")] | length')
          if [ "$BOT_REVIEWS" -gt "0" ]; then
            echo "dispatch=true" >> "$GITHUB_OUTPUT"
            echo "reason=participation" >> "$GITHUB_OUTPUT"; exit 0
          fi

          BOT_COMMENTS=$(gh api --paginate "repos/$GITHUB_REPOSITORY/issues/$PR_NUMBER/comments" \
            --jq '[.[] | select(.user.login == "<<cfg.bot_name>>")] | length')
          if [ "$BOT_COMMENTS" -gt "0" ]; then
            echo "dispatch=true" >> "$GITHUB_OUTPUT"
            echo "reason=participation" >> "$GITHUB_OUTPUT"; exit 0
          fi

          echo "dispatch=false" >> "$GITHUB_OUTPUT"
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          EVENT_NAME: ${{ github.event_name }}
          PR_NUMBER: ${{ github.event.pull_request.number }}
          BODY: ${{ github.event.comment.body || github.event.review.body }}
          COMMENT_AUTHOR: ${{ github.event.comment.user.login }}
          REVIEW_ID: ${{ github.event.review.id }}
          REVIEW_AUTHOR: ${{ github.event.review.user.login }}
          REVIEW_STATE: ${{ github.event.review.state }}
          REVIEW_BODY: ${{ github.event.review.body }}

      # Identifiers only. tend-mention re-reads the review or comment from the
      # API, so the words it acts on are the ones GitHub holds rather than
      # whatever this payload carried.
      - name: Relay to tend-mention
        if: steps.check.outputs.dispatch == 'true'
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          gh api "repos/$GITHUB_REPOSITORY/dispatches" \
            -f event_type=tend-mention-review \
            -f "client_payload[kind]=${{ github.event_name }}" \
            -f "client_payload[reason]=${{ steps.check.outputs.reason }}" \
            -f "client_payload[pr]=${{ github.event.pull_request.number }}" \
            -f "client_payload[id]=${{ github.event.review.id || github.event.comment.id }}" \
            -f "client_payload[url]=${{ github.event.review.html_url || github.event.comment.html_url }}" \
            -f "client_payload[ts]=${{ github.event.review.submitted_at || github.event.comment.updated_at }}"
