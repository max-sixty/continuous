#
# Do not edit this file directly ? it will be overwritten on regeneration.
# To customize behavior, edit the relevant skill (for example,
# `running-tend`) in this repo's .claude/skills/ directory, or open an issue at
# https://github.com/max-sixty/tend/issues for changes that need to
# happen upstream in the tend-ci-runner plugin.

name: tend-ci-fix
on:
  workflow_run:
    workflows: ["ci"]
    types: [completed]
    branches: ["main"]

jobs:
  classify:
    if: contains(fromJSON('["failure", "cancelled"]'), github.event.workflow_run.conclusion)
    runs-on: ubuntu-24.04
    outputs:
      should_fix: ${{ steps.classify.outputs.should_fix }}
    steps:
      - name: Classify completed run
        id: classify
        shell: python
        env:
          CONCLUSION: ${{ github.event.workflow_run.conclusion }}
          STARTED_AT: ${{ github.event.workflow_run.run_started_at }}
          UPDATED_AT: ${{ github.event.workflow_run.updated_at }}
        run: |
          import datetime
          import os

          should_fix = os.environ["CONCLUSION"] == "failure"
          if os.environ["CONCLUSION"] == "cancelled":
              parse = lambda value: datetime.datetime.fromisoformat(value.replace("Z", "+00:00"))
              elapsed = parse(os.environ["UPDATED_AT"]) - parse(os.environ["STARTED_AT"])
              # GitHub's hard cap is six hours. Leave five minutes for timestamp
              # rounding and runner teardown, while excluding ordinary cancels.
              should_fix = elapsed >= datetime.timedelta(hours=5, minutes=55)
          with open(os.environ["GITHUB_OUTPUT"], "a", encoding="utf-8") as output:
              print(f"should_fix={str(should_fix).lower()}", file=output)

  fix-ci:
    needs: classify
    if: needs.classify.outputs.should_fix == 'true'
    runs-on: ubuntu-24.04
    environment:
      name: tend
      deployment: false
    permissions:
      contents: write
      pull-requests: write
      actions: read
    steps:
      - uses: actions/checkout@v7
        with:
          ref: main
          fetch-depth: 0
          fetch-tags: true
          token: ${{ secrets.TEND_BOT_TOKEN }}

      - uses: max-sixty/tend/claude@X.Y.Z
        with:
          github_token: ${{ secrets.TEND_BOT_TOKEN }}
          claude_code_oauth_token: ${{ secrets.CLAUDE_CODE_OAUTH_TOKEN }}
          anthropic_api_key: ${{ secrets.ANTHROPIC_API_KEY }}
          bot_name: test-bot
          model: opus
          prompt: |2
            /tend-ci-runner:ci-fix ${{ github.event.workflow_run.id }}
            - Run URL: ${{ github.event.workflow_run.html_url }}
            - Commit: ${{ github.event.workflow_run.head_sha }}
            - Commit message: ${{ github.event.workflow_run.head_commit.message }}
